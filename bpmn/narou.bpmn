  <!-- createNovel -->
  <bpmn:process id="narou_create_novel" name="narou createNovel" isExecutable="true">
    <bpmn:startEvent id="Start_createNovel">
      <bpmn:outgoing>Flow_createNovel_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_createNovel" name="createNovel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.narou.createNovel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_createNovel_1</bpmn:incoming>
      <bpmn:outgoing>Flow_createNovel_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_createNovel">
      <bpmn:incoming>Flow_createNovel_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_createNovel_1" sourceRef="Start_createNovel" targetRef="Task_createNovel" />
    <bpmn:sequenceFlow id="Flow_createNovel_2" sourceRef="Task_createNovel" targetRef="End_createNovel" />
  </bpmn:process>

