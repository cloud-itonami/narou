              "status": "Planned",
              "dueDate": "2026-04-05"
            }
          ],
          "blockers": [],
          "dateModified": "2026-02-18T00:00:00Z"
        }
      },
      {
        "fileName": "uiux.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "CreativeWork",
          "name": "Narou AI UI/UX Design",
          "description": "iPad-first integrated creative environment for Novels, Manga, and Anime.",
          "etzhayyim:designPrinciples": [
            "Apple Human Interface Guidelines (iPad focused)",
            "Creative Flow: Multi-modal content creation without context switching",
            "Seamless scaling from text to animation",
            "Visual feedback loop for AI generation"
          ],
          "etzhayyim:uiComponents": [
            {
              "name": "Creator Studio Dashboard",
              "type": "IntegratedDashboard",
              "features": [
                "Project health overview",
                "Cross-media progress tracking (ProductionBoard)",
                "Resource usage monitoring for AI models"
              ]
            },
            {
              "name": "Novel Editor (Edra-based)",
              "type": "RichTextEditor",
              "features": [
                "Distraction-free focus mode",
                "Semantic tagging for characters and locations",
                "AI-assisted plot brainstorming"
              ]
            },
            {
              "name": "Manga Canvas",
              "type": "GraphicEditor",
              "features": [
                "AI layout suggestions from text",
                "Character consistency palette (LoRA selection)",
                "Dynamic panel resizing"
              ]
            },
            {
              "name": "Anime Director Timeline",
              "type": "TimelineEditor",
              "features": [
                "Multi-track sync (Video, Audio, Subtitles)",
                "Real-time AI voice generation preview",
                "Motion interpolation controls"
              ]
            }
          ],
          "etzhayyim:uxFlows": [
            {
              "name": "One-Click Media Mix Flow",
              "steps": [
                "Write novel chapter",
                "Select 'Generate Manga Name'",
                "Review and adjust AI-generated layouts",
                "Select 'Convert to Anime Clip'",
                "Sync AI voice with generated animation",
                "Publish across all formats"
              ]
            }
          ]
        }
      }
    ]
  }
}
