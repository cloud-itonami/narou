    },
    {
      "status": "completed",
      "task": "K8s Gateway API (HTTPRoute) による narou.etzhayyim.com のルーティング設計"
    },
    {
      "status": "completed",
      "task": "SvelteKit による Narou Studio のフロントエンド基本構造の実装"
    },
    {
      "status": "completed",
      "task": "メディアミックス・オーケストレーター (narouStore) の実装"
    },
    {
      "status": "in_progress",
      "task": "小説のチャプターから漫画ネームを自動生成するワークフローの構築"
    },
    {
      "status": "in_progress",
      "task": "AIボイスとモーション合成によるアニメーション生成パイプラインの統合"
    },
    {
      "status": "completed",
      "task": "ghosthacker/apps構造をベースにNarouプロジェクト構造を整理"
    },
    {
      "status": "completed",
      "task": "content JSON-LD自動生成スケジューラーの実装"
    },
    {
      "status": "in_progress",
      "task": "Drama生成パイプライン設計 (小説→脚本→絵コンテ→マンガドラマ変換)"
    },
    {
      "status": "pending",
      "task": "ジャンル・トロープテンプレートに基づくエピソード脚本バッチ生成の実装"
    },
    {
      "status": "pending",
      "task": "etzhayyim-project-drama への生成コンテンツ配信インターフェース (MCP gRPC) の実装"
    },
    {
      "status": "in_progress",
      "task": "ゲーム制作パイプライン設計 (小説世界観→GDD→GDScript→Godot Web Export→games.etzhayyim.com 配信)"
    },
    {
      "status": "pending",
      "task": "Story-to-Game シナリオ適応エンジンの実装 (プロット分岐→ゲームシナリオ変換)"
