{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "Narou AI Platform (etzhayyim-project-narou)",
  "status": "In Progress",
  "identifier": "etzhayyim-project-narou",
  "description": "小説・漫画・アニメの生成を支援する、AIネイティブな創作・配信プラットフォーム。Production AGIを活用し、テキストから動画までのメディアミックスをシームレスに行います。",
