              "name": "Drama脚本バッチ生成パイプラインの実装 (ジャンル・トロープテンプレート)",
              "status": "Planned",
              "dueDate": "2026-03-08"
            },
            {
              "@type": "CreativeWork",
              "name": "Motion-Ready Export (パネル→カメラ指示付きシーケンス) の実装",
